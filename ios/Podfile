require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Build React Native's third-party C++ dependencies (folly, glog, double-conversion,
# fmt, boost) from source instead of the prebuilt ReactNativeDependencies.xcframework.
# The prebuilt dynamic framework is not linked/embedded into the app target by
# CocoaPods, which causes "Undefined symbol: folly::… / google::LogMessage /
# double_conversion::…" linker errors when archiving. Building from source produces
# static libs that link cleanly via -l"RCT-Folly" / -l"glog" / -l"DoubleConversion".
# The prebuilt React core (React-Core-prebuilt / React.xcframework) depends on the
# prebuilt deps, so the two are coupled — build React core from source as well.
ENV['RCT_USE_RN_DEP'] = '0'
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'

platform :ios, '16.4'
prepare_react_native_project!

# Required by @react-native-firebase: the Swift Firebase pods (e.g.
# FirebaseCoreInternal) depend on GoogleUtilities and need module maps to import
# it as a static library. Do NOT enable this globally with `use_modular_headers!`:
# that force-modularizes React Native's source pods too, which makes clang load
# both React-RuntimeCore and React-jsitooling modulemaps (both declare
# `module react_runtime`) and fail with "Redefinition of module 'react_runtime'".
# Enable modular headers only for the Firebase/Google pods that actually need it.
$firebase_modular_header_pods = %w[
  FirebaseCore FirebaseCoreInternal FirebaseCoreExtension FirebaseInstallations
  FirebaseMessaging GoogleUtilities GoogleDataTransport PromisesObjC nanopb
]
$firebase_modular_header_pods.each do |pod_name|
  pod pod_name, :modular_headers => true
end

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'MOptic' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(require.resolve(\'expo-modules-autolinking\', { paths: [require.resolve(\'expo/package.json\')] }))(process.argv.slice(1))',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Create stub RuntimeAdapter.h -- new hermes-engine removed this header from
    # public API, but react-native-reanimated (with HERMES_ENABLE_DEBUGGER=1)
    # still pulls it in transitively through Registration.h.
    # Write to destroot (the actual file); pod install creates a symlink from
    # Headers/Public pointing here, so both paths resolve correctly.
    hermes_inspector_dir = File.join(
      installer.sandbox.root,
      "hermes-engine/destroot/include/hermes/inspector"
    )
    FileUtils.mkdir_p(hermes_inspector_dir)
    # RuntimeAdapter is used unqualified inside namespace
    # facebook::hermes::inspector_modern::chrome, so it must live in
    # inspector_modern (parent ns lookup finds it there).
    stub_content = [
      "// Stub: hermes removed this from public headers; kept for source compat.",
      "#pragma once",
      "#include <hermes/hermes.h>",
      "namespace facebook { namespace hermes { namespace inspector_modern {",
      "class RuntimeAdapter {",
      "public:",
      "  virtual ~RuntimeAdapter() = default;",
      "  virtual ::facebook::hermes::HermesRuntime &getRuntime() = 0;",
      "  virtual void tickleJs() = 0;",
      "};",
      "} } } // namespace facebook::hermes::inspector_modern",
    ].join("\n") + "\n"
    stub_path = File.join(hermes_inspector_dir, "RuntimeAdapter.h")
    # File may be read-only from a previous run; make it writable first.
    File.chmod(0644, stub_path) if File.exist?(stub_path)
    File.write(stub_path, stub_content)

    # Patch REASwizzledUIManager.mm: RCTRootView.intrinsicContentSize setter was
    # removed under RCT_REMOVE_LEGACY_ARCH (new arch). Guard the assignment so
    # the file still compiles with React Native 0.84+ new arch enabled.
    rea_swizzled_path = File.join(
      installer.sandbox.root,
      "../../node_modules/react-native-reanimated/apple/reanimated/apple/LayoutReanimation/REASwizzledUIManager.mm"
    )
    if File.exist?(rea_swizzled_path)
      content = File.read(rea_swizzled_path)
      old_line = "          rootView.intrinsicContentSize = contentSize;"
      new_line = "#ifndef RCT_REMOVE_LEGACY_ARCH\n          rootView.intrinsicContentSize = contentSize;\n#endif"
      if content.include?(old_line) && !content.include?("#ifndef RCT_REMOVE_LEGACY_ARCH")
        File.chmod(0644, rea_swizzled_path)
        File.write(rea_swizzled_path, content.sub(old_line, new_line))
      end
    end

    # fmt 11.0.x (built from source above) enables `consteval` format checks
    # that newer Apple clang (Xcode 26.4+/27) rejects as "not a constant
    # expression". fmt has no switch for it, so turn consteval off for Apple
    # clang in its detection block; fmt then checks formats at runtime instead.
    fmt_base = File.join(installer.sandbox.root, 'fmt/include/fmt/base.h')
    if File.exist?(fmt_base)
      fmt_src = File.read(fmt_base)
      fmt_old = "#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L"
      fmt_new = "#elif defined(__apple_build_version__) // patched: consteval breaks on newer Apple clang"
      if fmt_src.include?(fmt_old)
        File.chmod(0644, fmt_base)
        File.write(fmt_base, fmt_src.sub(fmt_old, fmt_new))
      end
    end

    # Xcode 27 refuses targets below its supported iOS range, and many pods
    # (mostly their privacy/resource-bundle targets) still declare iOS 8–13.
    # Lift every pod target to the app's own minimum (Expo SDK 56 needs 16.4).
    app_min_ios = '16.4'
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current.nil? || Gem::Version.new(current) < Gem::Version.new(app_min_ios)
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = app_min_ios
        end
      end
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['SWIFT_VERSION'] = '5.0'
        # Disable treat-warnings-as-errors globally for pods (Xcode 26 beta compatibility)
        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        config.build_settings['SWIFT_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        # Suppress specific warnings at compiler level as well.
        # NOTE: OTHER_CFLAGS may already be an Array (set by react_native_post_install).
        # Appending via string interpolation would stringify the array and corrupt
        # the build setting, so normalize to an Array and concatenate.
        extra_flags = ['-Wno-error=non-modular-include-in-framework-module', '-Wno-return-type']

        cflags = config.build_settings['OTHER_CFLAGS'] || ['$(inherited)']
        cflags = [cflags] unless cflags.is_a?(Array)
        config.build_settings['OTHER_CFLAGS'] = cflags + extra_flags

        cxx_flags = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || ['$(inherited)']
        cxx_flags = [cxx_flags] unless cxx_flags.is_a?(Array)
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = cxx_flags + extra_flags
      end
    end
  end
end
